# Required Microsoft Entra application credentials
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=replace-me

# Required for application-permission Microsoft Search requests
GRAPH_SEARCH_REGION=EUR

# Semicolon-separated SharePoint site URLs. All document libraries are included.
SHAREPOINT_SITE_URLS=https://example.sharepoint.com/sites/Engineering;https://example.sharepoint.com/sites/Research

# Transport: stdio or streamable-http
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Optional limits
MAX_SEARCH_RESULTS=50
MAX_DOWNLOAD_MB=100
MAX_RESPONSE_CHARACTERS=50000
MAX_SECTION_CHARACTERS=8000
EXTRACTION_TIMEOUT_SECONDS=120
GRAPH_REQUEST_TIMEOUT_SECONDS=60
GRAPH_MAX_RETRIES=4
LOG_LEVEL=INFO
